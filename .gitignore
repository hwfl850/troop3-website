# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp

# Worker tooling — the Worker source is committed, its build junk is not.
worker/node_modules/
worker/.wrangler/
worker/.dev.vars
worker/package-lock.json

# Never commit a token or a password. Both belong in Cloudflare secrets.
.env
.env.*
*.pem

# Python bytecode and pytest scratch from scripts/.
__pycache__/
*.pyc
.pytest_cache/

# A Google service account key belongs in a GitHub secret, never in the repo.
*-service-account.json
gcal-sa.json
